# Copy to .env and fill in. .env is git-ignored - never commit real values.

# ── KoboToolbox ───────────────────────────────────────────────────────────────
KOBO_API_TOKEN=
KOBO_ASSET_UID=
KOBO_BASE_URL=https://kf.kobotoolbox.org
KOBO_EXPORT_SETTINGS_ID=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=
PG_USER=
PG_PASSWORD=

# Target schemas (defaults shown)
# PG_RAW_SCHEMA=raw_data
# PG_CLEAN_SCHEMA=sarmaan2data
