# Copy to .env and fill in. .env is git-ignored - never commit real values.

# ── KoboToolbox ───────────────────────────────────────────────────────────────
KOBO_API_TOKEN=
KOBO_ASSET_UID=
KOBO_BASE_URL=https://kf.kobotoolbox.org
KOBO_EXPORT_SETTINGS_ID=

# ── Load target ───────────────────────────────────────────────────────────────
# databricks (default) | postgres | both   (both = parallel run before switch-over)
LOAD_TARGET=databricks

# ── Databricks ────────────────────────────────────────────────────────────────
# SQL Warehouses > (your warehouse) > Connection details
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
# Either a personal access token...
DATABRICKS_TOKEN=
# ...or a service principal (OAuth). Leave the token empty when using these.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Catalog: eha_ghi_sarmaan_dev (development) or eha_ghi_sarmaan_prod (production)
DATABRICKS_CATALOG=eha_ghi_sarmaan_dev
# Schemas and staging volume (defaults shown)
# DATABRICKS_BRONZE_SCHEMA=bronze
# DATABRICKS_SILVER_SCHEMA=silver
# DATABRICKS_GOLD_SCHEMA=gold
# DATABRICKS_RESTRICTED_SCHEMA=restricted
# DATABRICKS_STAGING_VOLUME=/Volumes/eha_ghi_sarmaan_dev/bronze/landing
# Recorded in bronze _pipeline_version (default: the git commit)
# PIPELINE_VERSION=

# ── PostgreSQL (only for LOAD_TARGET=postgres or both) ───────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=
PG_USER=
PG_PASSWORD=

# Target schemas (defaults shown)
# PG_RAW_SCHEMA=raw_data
# PG_CLEAN_SCHEMA=sarmaan2data
