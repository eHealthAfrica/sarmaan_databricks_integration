# Copy to .env and fill in. .env is git-ignored - never commit real values.

# Postgres target
PG_HOST=127.0.0.1
PG_PORT=5439
PG_DATABASE=sarmaan_2        # use "mortality" for the mortality pipeline
PG_USER=db_user
PG_PASSWORD=

# KoboToolbox API token (Account settings > Security > API key)
KOBO_TOKEN=

# Local data folders (mapping CSVs, kobo exports, pipeline_output)
SARMAAN_DIR=C:\path\to\SARMAAN 2\database
MORTALITY_DIR=C:\path\to\Mortality\database
